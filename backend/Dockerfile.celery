# Celery Worker Dockerfile
# For diarization and speaker identification tasks
# Uses flexible transformers version (compatible with pyannote/speechbrain)

FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    git-lfs \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && git lfs install

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Set working directory
WORKDIR /app

# Copy requirements (build context is already backend/)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/audio_files /app/models /app/speaker_profiles /app/logs

# Set Python path
ENV PYTHONPATH=/app

# Copy entrypoint script that configures git with HF token before running commands
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]

# Run Celery worker
# Models can be pre-downloaded to hidear_celery_models volume, or will be downloaded on first run
CMD ["celery", "-A", "celery_app", "worker", "--loglevel=info", "--concurrency=2"]
