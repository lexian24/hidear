# ============================================
# REQUIRED: HuggingFace Token
# ============================================
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_TOKEN=

# ============================================
# MERaLiON Model Selection
# ============================================
# For local testing (smaller model, ~3B parameters, 8GB VRAM):
# MERALION_MODEL=MERaLiON/MERaLiON-2-3B
# For production (large model, ~10B parameters, 24GB VRAM):
MERALION_MODEL=MERaLiON/MERaLiON-2-10B

# ============================================
# Port Configuration (External Ports)
# ============================================
# Change these if ports are already in use on your server
# Default ports: Backend=9427, MERaLiON=9428, Redis=7293, Redis-Commander=9429

# Frontend port (external access)
FRONTEND_PORT=

# Backend API port (external access)
BACKEND_PORT=
BACKEND_INTERNAL_PORT=

# MERaLiON service port (external access, usually internal only)
MERALION_PORT=
MERALION_INTERNAL_PORT=

# Redis port (external access, usually internal only)
REDIS_PORT

# Redis Commander port (optional, for debugging)
REDIS_COMMANDER_PORT

# ============================================
# Internal Service URLs (Docker Network)
# ============================================
# These use internal container names and ports
# DO NOT change unless you know what you're doing
MERALION_SERVICE_URL=http://meralion:8001
REDIS_URL=redis://redis:6379/0

# ============================================
# GPU Configuration
# ============================================
# Which GPU to use (0, 1, 2, 3, or leave empty for GPU 0)
GPU_ID=2

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000

# VAD Configuration
VAD_THRESHOLD=0.8

# Audio Processing
MAX_FILE_SIZE_MB=50

# Database Configuration
DATABASE_URL=sqlite:///./meraudio.db
DATABASE_ECHO=false  # Set to true to enable SQL query logging

# Development Settings
DEBUG=false
ENABLE_GPU=true